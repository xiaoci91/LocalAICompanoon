{
  "schemaVersion": 1,
  "id": "localaicompanion",
  "version": "${version}",
  "name": "Local AI Companion",
  "description": "本地AI同伴模组，可以对接Ollama、LM-Studio本地大模型，在游戏内生成AI NPC进行对话交互。需要自行部署本地大模型服务，本模组不会内置任何大模型",
  "authors": [
    "xiaoci"
  ],
  "contact": {
    "homepage": "https://github.com/xiaoci91/LocalAICompanoon",
    "sources": "https://github.com/xiaoci91/LocalAICompanoon"
  },
  "license": "MIT",
  "icon": "assets/localaicompanion/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.localaicompanion.LocalAICompanion"
    ],
    "client": [
      "com.localaicompanion.LocalAICompanionClient"
    ],
    "modmenu": [
      "com.localaicompanion.gui.ModMenuIntegration"
    ]
  },
  "mixins": [
    "localaicompanion.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.0",
    "fabric-api": "*",
    "minecraft": "~1.20.1",
    "java": ">=17"
  },
  "suggests": {
    "baritone": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": ""
      }
    }
  }
}

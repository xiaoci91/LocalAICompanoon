{
  "schemaVersion": 1,
  "id": "localaicompanion",
  "version": "${version}",
  "name": "Local AI Companion",
  "description": "Local AI Companion mod. Connects to local LLM services like Ollama or LM-Studio to spawn AI NPCs in-game for conversation. Requires a local LLM server - no model is bundled with this mod.",
  "authors": [
    "xiaoci"
  ],
  "contact": {
    "homepage": "https://github.com/xiaoci91/LocalAICompanoon",
    "sources": "https://github.com/xiaoci91/LocalAICompanoon"
  },
  "license": "MIT",
  "icon": "assets/localaicompanion/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.localaicompanion.LocalAICompanion"
    ],
    "client": [
      "com.localaicompanion.LocalAICompanionClient"
    ],
    "modmenu": [
      "com.localaicompanion.gui.ModMenuIntegration"
    ]
  },
  "mixins": [
    "localaicompanion.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.0",
    "fabric-api": "*",
    "minecraft": "~1.20.1",
    "java": ">=17"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": ""
      }
    }
  }
}
